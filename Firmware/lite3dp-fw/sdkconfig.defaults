# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Flash / Partition
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# SPI master
CONFIG_SPI_MASTER_IN_IRAM=y

# WiFi
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y

# HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# SPIFFS
CONFIG_SPIFFS_MAX_PARTITIONS=1

# FATFS — slicers write names like "pyramid00000.png"; without long
# filename support the card only exposes mangled 8.3 names (PYRAM~1.PNG),
# so no layer can be opened by its real name. Heap-allocated so the LFN
# buffer doesn't land on a caller's stack.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# LVGL
# Byte-swap LVGL's RGB565 output to match the TFT's big-endian SPI byte order
# (the PNG mask path and tft_fill_screen already produce big-endian).
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_40=y

# LVGL logging. Without this an LV_ASSERT_MALLOC (its private pool is only
# LV_MEM_SIZE_KILOBYTES, separate from the ESP heap) produces no output at all
# before halting the UI task — a silent frozen display. WARN is quiet in
# normal operation and names the failing expression when it matters.
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# Supplies LITE3DP_LV_ABORT, which replaces LVGL's `while(1);` assert handler
# with abort(). See lv_hooks/lite3dp_lv_assert.h and the top-level CMakeLists.
CONFIG_LV_ASSERT_HANDLER_INCLUDE="lite3dp_lv_assert.h"

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
